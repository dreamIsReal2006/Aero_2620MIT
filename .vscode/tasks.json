{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Aero backend (Render standard)",
			"type": "shell",
			"command": "D:\\foundation_in_computing\\Sem 3\\MIT\\Aero(github)\\Aero_2620MIT\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
